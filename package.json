{
  "name": "contact-registry",
  "version": "0.1.1",
  "private": true,
  "description": "Portable contact registry for Windows",
  "author": "Admutium",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-isolation=none",
    "build:win": "electron-builder --win zip --x64 --publish never",
    "build:linux": "electron-builder --linux dir",
    "test:ui": "node scripts/ui-smoke.cjs"
  },
  "dependencies": {
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.admutium.contactregistry",
    "productName": "ContactRegistry",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "zip",
      "signAndEditExecutable": false
    },
    "artifactName": "ContactRegistry-${version}-win-${arch}.${ext}"
  }
}
